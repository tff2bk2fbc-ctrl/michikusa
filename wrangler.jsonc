{
  "name": "broad-wildflower-9e30",
  "compatibility_date": "2025-01-01",
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": ["*/15 * * * *", "17 18 * * *"]
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "michikusa-e34df",
    "FIREBASE_WEB_API_KEY": "AIzaSyAJFFjRk6zvAA_L9-1O7Y7Q43Yw86QQtxM",
    "WIKIPEDIA_API_STATE": "disabled"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.05,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.05,
      "invocation_logs": false
    }
  },
  "ratelimits": [
    {
      "name": "POSTAL_USER_RATE_LIMITER",
      "namespace_id": "10001",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "POSTAL_GLOBAL_RATE_LIMITER",
      "namespace_id": "10002",
      "simple": { "limit": 1000, "period": 60 }
    },
    {
      "name": "SOCIAL_READ_RATE_LIMITER",
      "namespace_id": "10003",
      "simple": { "limit": 180, "period": 60 }
    },
    {
      "name": "SOCIAL_WRITE_RATE_LIMITER",
      "namespace_id": "10004",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "SHARE_RATE_LIMITER",
      "namespace_id": "10005",
      "simple": { "limit": 90, "period": 60 }
    },
    {
      "name": "GEOCODE_RATE_LIMITER",
      "namespace_id": "10006",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "MAP_PLACES_RATE_LIMITER",
      "namespace_id": "10007",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "MAP_PLACES_GLOBAL_RATE_LIMITER",
      "namespace_id": "10008",
      "simple": { "limit": 2000, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "michikusa-db",
      "database_id": "e85e9ae2-3905-477b-b6e6-4c3abd9f7e39"
    },
